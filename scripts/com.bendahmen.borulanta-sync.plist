<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.bendahmen.borulanta-sync</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/bendahmen/Library/CloudStorage/Dropbox/Ben/Documents/Hobbies/Coding/projects/borulanta/scripts/sync-and-commit.sh</string>
  </array>

  <!-- Friday morning. Wednesday's game, a day and a half for the league to put
       the score up. If the Mac is asleep at eight, launchd runs it on waking. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>5</integer>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <!-- The script logs to raw/sync.log itself; these catch anything that goes
       wrong before it gets that far. -->
  <key>StandardOutPath</key>
  <string>/Users/bendahmen/Library/CloudStorage/Dropbox/Ben/Documents/Hobbies/Coding/projects/borulanta/raw/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/bendahmen/Library/CloudStorage/Dropbox/Ben/Documents/Hobbies/Coding/projects/borulanta/raw/launchd.log</string>
</dict>
</plist>
