---
// A section's own views, as tabs along the top of the page.
const { items, label, current } = Astro.props;
---
<nav class="subnav" aria-label={label}>
  {
    items.map((item) => (
      <a href={item.href} aria-current={item.id === current ? 'page' : undefined}>
        {item.label}
      </a>
    ))
  }
</nav>

<style>
  .subnav {
    display: flex;
    gap: 4px;
    margin-bottom: 12px;
    padding: 3px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
  }

  a {
    flex: 1 1 0;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    border-radius: 9px;
    color: var(--ink);
    font-weight: 400;
    text-decoration: none;
  }

  a[aria-current='page'] {
    background: var(--blue-soft);
    color: var(--blue);
    font-weight: 600;
  }

  a:focus-visible {
    outline-offset: -2px;
  }

  @media (min-width: 768px) {
    .subnav {
      display: inline-flex;
    }

    a {
      flex: 0 0 auto;
      padding: 0 22px;
    }
  }
</style>
