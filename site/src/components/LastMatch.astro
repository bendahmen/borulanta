---
import home from '../generated/home.json';
import { MATCHES } from '../lib/labels.js';
import { matchHref } from '../lib/match-data.js';
import MatchSummary from './MatchSummary.astro';

const played = home.last_match;
// A match dated before the first season has no page. See export_match_pages() in R.
const href = played?.season_label ? matchHref(played.date) : null;
---
<section class="card last" aria-labelledby="last-match-tag">
  <h2 id="last-match-tag" class="tag">{home.last_match_tag}</h2>
  {
    played ? (
      <>
        <MatchSummary played={played} />
        {href && (
          <a class="to-match" href={href} aria-label={MATCHES.matchPageFor(played.date_label)}>
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
              <path d="m9 6 6 6-6 6" />
            </svg>
          </a>
        )}
      </>
    ) : (
      <p class="empty">{home.last_match_empty}</p>
    )
  }
</section>

<style>
  .last {
    position: relative;
  }

  /* The whole card is the link, and the chevron says so. Neither takes any room, so nothing
     else on the card moves. */
  .to-match {
    color: var(--ink-muted);
  }

  .to-match::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 16px;
  }

  .to-match:focus-visible {
    outline: none;
  }

  .to-match:focus-visible::after {
    outline: 2px solid var(--blue);
    outline-offset: 2px;
  }

  .to-match svg {
    position: absolute;
    top: 12px;
    right: 12px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .empty {
    padding: 12px 0 4px;
    color: var(--ink-muted);
  }
</style>
