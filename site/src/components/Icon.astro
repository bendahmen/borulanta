---
// Inline so the tab bar needs no request and no icon library.
const { name } = Astro.props;
---
<svg
  class="icon"
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'home' && <path d="M3.5 10.8 12 3.8l8.5 7V20a.8.8 0 0 1-.8.8H15v-5.6H9v5.6H4.3a.8.8 0 0 1-.8-.8z" />}
  {name === 'fees' && (
    <Fragment>
      <circle cx="12" cy="12" r="8.8" />
      <path d="M14.8 9a2.6 2.6 0 0 0-5.1.6c0 1.6.7 2.5.7 4 0 1.1-.5 1.9-1.4 2.6h5.8M8.8 12.6h4.2" />
    </Fragment>
  )}
  {name === 'league' && (
    <Fragment>
      <path d="M8 3.8h8V10a4 4 0 0 1-8 0z" />
      <path d="M8 5.6H4.6v1.6A3.4 3.4 0 0 0 8 10.6M16 5.6h3.4v1.6a3.4 3.4 0 0 1-3.4 3.4" />
      <path d="M12 14v3.4M8.6 20.2h6.8M10 17.4h4l.7 2.8H9.3z" />
    </Fragment>
  )}
  {name === 'matches' && (
    <Fragment>
      <circle cx="12" cy="12" r="8.8" />
      <path d="m12 7.8 4 2.9-1.5 4.7h-5L8 10.7z" />
      <path d="M12 7.8V3.2M16 10.7l4.4-1.4M14.5 15.4l2.7 3.7M9.5 15.4l-2.7 3.7M8 10.7 3.6 9.3" />
    </Fragment>
  )}
  {name === 'players' && (
    <Fragment>
      <circle cx="9.2" cy="8" r="3.6" />
      <path d="M2.8 20.2a6.4 6.4 0 0 1 12.8 0" />
      <path d="M15.8 4.7a3.6 3.6 0 0 1 0 6.6M17.9 14.2a6.4 6.4 0 0 1 3.3 6" />
    </Fragment>
  )}
</svg>
