---
// Our row of the league table and two sides either way, in the HTML. The full table and the
// run-in are on League.
import '../styles/data-table.css';

import league from '../generated/league.json';
import meta from '../generated/meta.json';
import wording from '../generated/wording.json';
import { tableHtml } from '../lib/data-table.js';
import { leagueWindow } from '../lib/home-tables.js';
import { HOME } from '../lib/labels.js';
import { leagueColumns } from '../lib/league-table.js';
import CardHead from './CardHead.svelte';

const rows = leagueWindow(league.rows, meta.our_team);
const table = tableHtml({
  className: 'dt-league dt-tight',
  caption: HOME.league.title,
  columns: leagueColumns(wording.league_cards.headings),
  rows,
  rowClass: (row) => (row.team === meta.our_team ? 'is-us' : ''),
  rowAttributes: (row) => (row.team === meta.our_team ? { 'aria-current': 'true' } : {}),
});
---
{
  rows.length > 0 && (
    <section class="card league" aria-labelledby="home-league-title">
      <CardHead id="home-league-title" card={{ tag: HOME.league.tag, title: HOME.league.title, subtitle: league.subtitle }} />
      <Fragment set:html={table} />
      <a class="more" href="/league/">{HOME.league.link}</a>
    </section>
  )
}

<style>
  .more {
    display: inline-block;
    margin-top: 10px;
    color: var(--blue);
    font-size: 0.9375rem;
    text-underline-offset: 2px;
  }
</style>
