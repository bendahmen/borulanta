---
import '../../../styles/data-table.css';

import RosterPage from '../../../components/players/RosterPage.svelte';
import SeasonTicksScript from '../../../components/SeasonTicksScript.astro';
import meta from '../../../generated/meta.json';
import wording from '../../../generated/wording.json';
import Players from '../../../layouts/Players.astro';
import { NO_SCRIPT, PAGES } from '../../../lib/labels.js';
---
<Players view="roster">
  <h1 class="visually-hidden">{PAGES.roster.title}</h1>
  <RosterPage client:load seasons={meta.seasons} noMatches={meta.empty_states.no_matches} cards={wording.players_cards} />
  <SeasonTicksScript />
  <noscript>
    <style is:inline>astro-island { display: none; }</style>
    <p class="card no-script">{NO_SCRIPT.roster}</p>
  </noscript>
</Players>

<style>
  .no-script {
    color: var(--ink-muted);
  }
</style>
