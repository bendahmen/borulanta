---
import EffectsPage from '../../../components/effects/EffectsPage.svelte';
import SeasonTicksScript from '../../../components/SeasonTicksScript.astro';
import meta from '../../../generated/meta.json';
import wording from '../../../generated/wording.json';
import Players from '../../../layouts/Players.astro';
import { NO_SCRIPT, PAGES } from '../../../lib/labels.js';
---
<Players view="effects">
  <h1 class="visually-hidden">{PAGES.effects.title}</h1>
  <EffectsPage
    client:load
    seasons={meta.seasons}
    emptyStates={{ no_matches: meta.empty_states.no_matches, no_regression: meta.empty_states.no_regression }}
    outcomeLabels={meta.outcome_labels}
    estimatorControl={wording.estimator_control}
    cards={wording.effects_cards}
    plotLabels={{ attack_defence: wording.plot_labels.attack_defence, coefficient: wording.plot_labels.coefficient }}
  />
  <SeasonTicksScript />
  <noscript>
    <style is:inline>astro-island { display: none; }</style>
    <p class="card no-script">{NO_SCRIPT.effects}</p>
  </noscript>
</Players>

<style>
  .no-script {
    color: var(--ink-muted);
  }
</style>
