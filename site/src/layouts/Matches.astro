---
// Matches has two sub-views, both with the season picker, as SEASON_SCOPED_TABS in app.R
// records. Their tables use src/styles/data-table.css.
import '../styles/data-table.css';

import SubNav from '../components/SubNav.astro';
import { MATCHES_NAV, MATCHES_NAV_LABEL, PAGES } from '../lib/labels.js';
import Base from './Base.astro';

const { view } = Astro.props;
const page = PAGES[view];
---
<Base title={page.title} description={page.description} current="matches">
  <SubNav items={MATCHES_NAV} label={MATCHES_NAV_LABEL} current={view} />
  <h1 class="visually-hidden">{page.title}</h1>
  <slot />
</Base>
