---
// Players has two sub-views. Season-scoped controls go in the page, not here.
import SubNav from '../components/SubNav.astro';
import { PAGES, PLAYERS_NAV, PLAYERS_NAV_LABEL } from '../lib/labels.js';
import Base from './Base.astro';

const { view } = Astro.props;
const page = PAGES[view];
---
<Base title={page.title} description={page.description} current="players">
  <SubNav items={PLAYERS_NAV} label={PLAYERS_NAV_LABEL} current={view} />
  <slot />
</Base>
